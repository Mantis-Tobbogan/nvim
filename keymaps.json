{
  "version": 1,
  "updated": "2026-10-20",
  "leader": "space",
  "description": "Canonical keymap spec shared by Neovim (LazyVim), VSCode (VSCodeVim) and Zed (native vim). Neovim is the source of truth; VSCode and Zed are ports. A null editor means that editor has no equivalent capability.",
  "key_notation": {
    "canonical": "space = leader, then literal keys; ctrl-x / shift-x / alt-x for modifiers; F5 style for function keys",
    "nvim": "<leader> expands to a literal space; ctrl-x is <C-x>; shift-x is <S-x>",
    "vscode": "space is the space key; ctrl+x is written ctrl+x",
    "zed": "space is the space key; ctrl-x is written ctrl-x"
  },
  "groups": [
    {
      "name": "Files & search",
      "maps": [
        {
          "id": "files.find.root",
          "keys": "space space",
          "action": "Find files (project root)",
          "nvim": {
            "key": "<leader><space>",
            "impl": "telescope find_files (root)"
          },
          "vscode": {
            "key": "space space",
            "command": "workbench.action.quickOpen"
          },
          "zed": {
            "key": "space space",
            "action": "file_finder::Toggle"
          }
        },
        {
